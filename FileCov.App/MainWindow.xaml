<Window x:Class="FileCov.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileCov.App.ViewModels"
        xmlns:converters="clr-namespace:FileCov.App.Converters"
        xmlns:contracts="clr-namespace:FileCov.Contracts;assembly=FileCov.Contracts"
        Title="FileCov - 多格式文档转换器"
        Height="700" Width="1000"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#141422" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FileCov" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="多格式文档转换器" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="8,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource AccentButtonStyle}" Content="&#xE8E5; 添加文件" Command="{Binding AddFilesCommand}" Margin="4,0"/>
                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="8,2"/>
                <Button Style="{StaticResource ToolBarButtonStyle}" Content="&#xE768; 全部开始" Command="{Binding StartAllCommand}"/>
                <Button Style="{StaticResource ToolBarButtonStyle}" Content="&#xE769; 全部暂停" Command="{Binding PauseAllCommand}"/>
                <Button Style="{StaticResource ToolBarButtonStyle}" Content="&#xE768; 全部恢复" Command="{Binding ResumeAllCommand}"/>
                <Button Style="{StaticResource ToolBarButtonStyle}" Content="&#xE711; 全部取消" Command="{Binding CancelAllCommand}"/>
                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="8,2"/>
                <Button Style="{StaticResource ToolBarButtonStyle}" Content="&#xE9D9; 导出日志" Command="{Binding ExportLogsCommand}"/>
                <Button Style="{StaticResource ToolBarButtonStyle}" Content="&#xE8DA; 打开输出文件夹" Command="{Binding OpenOutputFolderCommand}"/>
            </StackPanel>
        </Border>

        <!-- Progress Bar Area -->
        <Border Grid.Row="2" Background="#1A1A2E" Padding="16,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Row="0" Grid.Column="0" Value="{Binding OverallProgress}" Maximum="100" Margin="0,0,12,0" Height="18"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding RemainingTimeText}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="拖拽文件到此窗口以添加转换任务" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content: Task List + Settings -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Task List -->
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Tasks}"
                      SelectedItem="{Binding SelectedTask}"
                      Margin="0"
                      RowDetailsVisibilityMode="Collapsed">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="文件名" Width="*" Binding="{Binding InputPath}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding InputPath}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="源格式" Width="60" Binding="{Binding InputPath, Converter={x:Static converters:ExtensionConverter.Instance}}"/>

                    <DataGridTextColumn Header="目标格式" Width="60" Binding="{Binding TargetFormat}"/>

                    <DataGridTemplateColumn Header="状态" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" FontWeight="Medium">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource StatusToBrushConverter}">
                                            <Binding Path="Status"/>
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="进度" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="12"/>
                                    <TextBlock Text="{Binding Progress, StringFormat={}{0:F0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="White"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="耗时" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:hh\\:mm\\:ss}">
                                            <Binding Path="Result.Duration"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="操作" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SmallButtonStyle}" Content="暂停" Margin="2,0"
                                            Visibility="{Binding Status, Converter={x:Static converters:StatusToVisibilityConverter.PauseVisible}}"
                                            Command="{Binding DataContext.PauseTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource SmallButtonStyle}" Content="恢复" Margin="2,0"
                                            Visibility="{Binding Status, Converter={x:Static converters:StatusToVisibilityConverter.ResumeVisible}}"
                                            Command="{Binding DataContext.ResumeTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource SmallButtonStyle}" Content="取消" Margin="2,0"
                                            Visibility="{Binding Status, Converter={x:Static converters:StatusToVisibilityConverter.CancelVisible}}"
                                            Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Settings Panel -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>

                    <TextBlock Text="输出目录" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" FontSize="11"/>
                        <Button Grid.Column="1" Content="..." Style="{StaticResource SmallButtonStyle}" Command="{Binding BrowseOutputCommand}" Margin="4,0,0,0" Padding="8,4"/>
                    </Grid>

                    <TextBlock Text="页面大小" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox SelectedItem="{Binding PageSize}" Margin="0,0,0,12">
                        <ComboBoxItem Content="A4" IsSelected="True"/>
                        <ComboBoxItem Content="Letter"/>
                        <ComboBoxItem Content="Legal"/>
                    </ComboBox>

                    <TextBlock Text="图片质量" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Value="{Binding ImageQuality}" Minimum="1" Maximum="100" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ImageQuality}" Width="30" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Margin="6,0,0,0"/>
                    </Grid>
                    <TextBlock Text="1 (低) — 100 (高)" FontSize="10" Foreground="#707080" Margin="0,0,0,12"/>

                    <TextBlock Text="最大并发数" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Value="{Binding MaxConcurrency}" Minimum="1" Maximum="8" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding MaxConcurrency}" Width="20" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Margin="6,0,0,0"/>
                    </Grid>

                    <Rectangle Fill="{StaticResource BorderBrush}" Height="1" Margin="0,4,0,12"/>

                    <TextBlock Text="可用转换器" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding AvailableConverters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A1A2E" CornerRadius="4" Padding="8,5" Margin="0,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Drag/Drop Overlay -->
        <Border Grid.Row="3" Name="DropOverlay" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="释放以添加文件" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="支持拖拽文件到此窗口" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="4" Background="#141422" Padding="12,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}任务数: {0} | 并发: {1}">
                            <Binding Path="Tasks.Count"/>
                            <Binding Path="MaxConcurrency"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
